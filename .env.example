# Hugging Face access token (required for downloading raw MCD dataset from Hugging Face)
HF_TOKEN=your_huggingface_token_here
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Kaggle credentials (required for uploading datasets or running automation via Kaggle API)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
KAGGLE_API_TOKEN=your_kaggle_api_token
